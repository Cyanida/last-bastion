{
  "name": "last-bastion",
  "productName": "Last Bastion",
  "description": "Medieval wave-survival game",
  "author": "Cyanida",
  "private": true,
  "version": "0.7.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "sim": "vite-node scripts/simulate.ts",
    "icons": "vite-node scripts/make-icons.ts",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs",
    "cap:sync": "npm run build && cap sync",
    "test:perf": "node scripts/perf-test.mjs",
    "test:play": "node scripts/play-test.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "io.github.cyanida.lastbastion",
    "productName": "Last Bastion",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "last-bastion-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Last Bastion",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "Cyanida",
      "repo": "last-bastion",
      "releaseType": "release"
    }
  }
}
